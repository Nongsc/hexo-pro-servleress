# Neon PostgreSQL connection string (serverless Postgres).
# Required for durable storage of users/settings/deploy status/recycle bin.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# Set to true only if your provider requires it (Neon already uses SSL).
DATABASE_SSL=true

# Directory holding the git content repo (a full hexo site: _config.yml, source/, themes/).
CONTENT_DIR=./content

# Optional: clone this repo into CONTENT_DIR on first boot when the dir is empty.
#GIT_REPO_URL=https://github.com/you/your-hexo-site.git

# Git author identity used for content commits.
GIT_AUTHOR_NAME=Hexo Pro
GIT_AUTHOR_EMAIL=hexo-pro@example.com

# Push the content repo after every commit when true (Qexo-style CI builds).
AUTO_PUSH=false

# Server port (the client is built with publicPath /pro/ and calls /hexopro/api).
PORT=8001

# Optional overrides for the public site url/root used to compute permalinks.
#HEXO_PRO_URL=http://localhost:8001
#HEXO_PRO_ROOT=/

# Optional JWT secret (otherwise generated and persisted in the DB).
#JWT_SECRET=
