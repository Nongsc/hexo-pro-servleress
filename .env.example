# Neon PostgreSQL connection string (serverless Postgres).
# Required for durable storage of users/settings/deploy status/recycle bin.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# Set to true only if your provider requires it (Neon already uses SSL).
DATABASE_SSL=true

# GitHub content repo (Qexo-style: content lives here, synced via API).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# Optional: runtime directories (defaults shown).
#DATA_DIR=./data
#UPLOAD_DIR=./uploads

# Optional: Tencent COS for image hosting (otherwise images stay local only).
#COS_SECRET_ID=
#COS_SECRET_KEY=
#COS_BUCKET=
#COS_REGION=

# Server port (the client is built with publicPath /pro/ and calls /hexopro/api).
PORT=8001

# Optional overrides for the public site url/root used to compute permalinks.
#HEXO_PRO_URL=http://localhost:8001
#HEXO_PRO_ROOT=/

# Optional JWT secret (otherwise generated and persisted in the DB).
#JWT_SECRET=
